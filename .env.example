# Copy to .env.local for local development (never commit real secrets).
#
# --- Supabase project (required) ---------------------------------------
# Create a project at https://supabase.com, or run `supabase start` locally
# (requires Docker) — see docs/INSTALL.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses Row Level Security — never expose to the browser.
# Used only by: automation rule execution, PM work-order generation cron,
# and admin scripts. See src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this deployment, used to build auth email redirect
# links (signup confirmation, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Automations cron (required only if you wire up the scheduled job) --
# Shared secret checked by app/api/automations/run — see docs/AUTOMATIONS.md.
AUTOMATIONS_CRON_SECRET=change-me

# --- AI assist layer (optional) ------------------------------------------
# When unset, the AI assist features are disabled everywhere (a no-op
# provider is used instead) rather than the app crashing or faking output.
# See docs/AI_FEATURES.md.
ANTHROPIC_API_KEY=

# --- Local development database (used only by scripts/db-*.sh) ----------
# Points at the plain-Postgres local dev database described in
# db/local_dev_shim.sql — irrelevant once you're using `supabase start` or a
# hosted project, which manage their own connection.
DATABASE_URL=postgres://app_dev:dev_password_change_me@localhost:5432/intervia
